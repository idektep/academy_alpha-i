    {
        "id": "8a6a5f1d6b0c2d22",
        "type": "function",
        "z": "f119e404760129e4",
        "name": "Clear dashboard (chart + LEDs + text)",
        "func": "// Output 1 -> chart, Output 2 -> normal LED, Output 3 -> alert LED, Output 4 -> alarm LED, Output 5 -> predicted text\n\n// 1) Clear ui_chart (Node-RED Dashboard): send msg.payload = [] to clear\nlet chartMsg = { payload: [] };\n\n// 2) Reset LEDs off\nlet normalOff = { payload: false };\nlet alertOff  = { payload: false };\nlet alarmOff  = { payload: false };\n\n// 3) Clear predicted text (optional)\n// ui_text uses format: {{msg.payload.y_label_pred || msg.payload.y_label}}\n// so send empty object to make it blank\nlet textClear = { payload: {} };\n\nreturn [chartMsg, normalOff, alertOff, alarmOff, textClear];",
        "outputs": 5,
        "timeout": "",
        "noerr": 0,
